# ---- Required for the workspace ------------------------------------------
# Railway: add a reference variable on the app service:  DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres@localhost:5433/peedf_dev
# Long random string (e.g. `openssl rand -hex 32`). Signs visitor cookies and download links.
SESSION_SECRET=

# ---- AI (optional; without it, AI tasks explain they're not switched on) ----
ANTHROPIC_API_KEY=
# AI_PLANNER_MODEL=claude-haiku-5-5      # sees the instruction + file names/page counts only
# AI_ANALYSIS_MODEL=claude-sonnet-5-5    # reads document text for summaries/answers/extraction
# AI_PRICE_INPUT_PER_MTOK=               # optional, USD; only used to report estimated cost
# AI_PRICE_OUTPUT_PER_MTOK=

# ---- Site / analytics ------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://peedf.com
# NEXT_PUBLIC_GA_ID=G-2X1XTPV299          # "off" disables analytics
# NEXT_PUBLIC_GSC_VERIFICATION=           # Search Console HTML-tag token, if using that method

# ---- MOTHER (optional): every ops event is POSTed here as JSON -------------
# EVENTS_WEBHOOK_URL=
# EVENTS_WEBHOOK_SECRET=

# ---- Limits (safety caps, not pricing; defaults shown) ---------------------
# MAX_FILE_MB=50
# MAX_FILES_PER_JOB=10
# MAX_JOB_MB=100
# MAX_PAGES_PER_FILE=500
# MAX_AI_PAGES_PER_JOB=150
# MAX_ACTIVE_JOBS_PER_VISITOR=3
# JOBS_PER_VISITOR_PER_DAY=40
# AI_JOBS_PER_VISITOR_PER_DAY=10
# JOBS_PER_IP_PER_HOUR=60
# RETENTION_HOURS=24
# JOB_METADATA_DAYS=30
# DOWNLOAD_LINK_TTL_SECONDS=900
# WORKER_CONCURRENCY=2
# SANDBOX_MEMORY_MB=1536
# STEP_TIMEOUT_MS=180000
